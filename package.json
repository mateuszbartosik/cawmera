{
  "name": "cawmera",
  "productName": "Cawmera",
  "version": "0.7.0",
  "private": true,
  "description": "Puts a screenshot into a frame",
  "author": "Mateusz Bartosik",
  "license": "MIT",
  "repository": "github:mateuszbartosik/cawmera",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:web": "vite build --config vite.web.config.ts",
    "build:recorder": "node scripts/build-recorder.mjs",
    "dist:win": "npm run build:recorder && npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.10.1",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "4.1.12"
  }
}
